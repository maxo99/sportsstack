          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT \n    timestamp AS time,\n    bookmaker || ' - ' || choice AS metric,\n    price AS value\nFROM eventoffer\nWHERE event_id = '$event_id'\n  AND offer_type = '$offer_type'\n  AND timestamp >= $__timeFrom()::timestamptz\n  AND timestamp <= $__timeTo()::timestamptz\nORDER BY timestamp ASC;",
          "refId": "A"
        }
      ],
      "title": "Odds Movement Over Time - $event_id ($offer_type)",
