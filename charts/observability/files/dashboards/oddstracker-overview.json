      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "oddstracker-timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH latest_odds AS (\n    SELECT DISTINCT ON (bookmaker)\n        timestamp AS time,\n        bookmaker,\n        price\n    FROM eventoffer\n    WHERE event_id = '$event_id'\n      AND offer_type = '$offer_type'\n      AND choice = '$choice'\n    ORDER BY bookmaker, timestamp DESC\n)\nSELECT \n    time,\n    MAX(price) AS best_price,\n    MIN(price) AS worst_price,\n    MAX(price) - MIN(price) AS spread,\n    (MAX(price) - MIN(price)) / MIN(price) * 100 AS spread_percentage\nFROM latest_odds\nGROUP BY time;\n",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "ODDS SPREAD COMPARISON - $event_id, $offer_type, $choice",
      "type": "timeseries"
    },
